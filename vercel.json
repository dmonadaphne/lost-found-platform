{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{node_modules/onnxruntime-web/**,node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/|@|src/|node_modules/)[^.]*)", "destination": "/index.html" }
  ]
}